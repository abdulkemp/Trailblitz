# Copy this file to .env and fill in your own values.

# Port the API listens on
PORT=3000

# MySQL connection
# These defaults match docker-compose.yml. If you use your own MySQL
# (XAMPP, MySQL Workbench, etc.), change them to your details.
DB_HOST=localhost
DB_PORT=3306
DB_USER=trailblitz
DB_PASSWORD=trailblitz
DB_NAME=trailblitz

# Origins allowed to call the API (comma-separated).
# Not needed in development: the Vite dev server proxies /api.
CORS_ORIGIN=http://localhost:5173
